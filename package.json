{
  "name": "@akira-io/sisp",
  "version": "1.0.0-beta.6",
  "description": "SISP/Vinti4 (Cabo Verde) payment gateway client for Node.js",
  "license": "(MIT OR Apache-2.0)",
  "author": "Kidiatoliny <kidiatoliny@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akira-io/node-sisp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "bin": {
    "sisp": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      },
      "require": {
        "types": "./dist/express/index.d.cts",
        "default": "./dist/express/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify/index.d.ts",
        "default": "./dist/fastify/index.js"
      },
      "require": {
        "types": "./dist/fastify/index.d.cts",
        "default": "./dist/fastify/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/nest/index.d.cts",
        "default": "./dist/nest/index.cjs"
      }
    },
    "./prisma": {
      "import": {
        "types": "./dist/prisma/index.d.ts",
        "default": "./dist/prisma/index.js"
      },
      "require": {
        "types": "./dist/prisma/index.d.cts",
        "default": "./dist/prisma/index.cjs"
      }
    },
    "./knex": {
      "import": {
        "types": "./dist/knex/index.d.ts",
        "default": "./dist/knex/index.js"
      },
      "require": {
        "types": "./dist/knex/index.d.cts",
        "default": "./dist/knex/index.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle/index.d.ts",
        "default": "./dist/drizzle/index.js"
      },
      "require": {
        "types": "./dist/drizzle/index.d.cts",
        "default": "./dist/drizzle/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "express": [
        "./dist/express/index.d.ts"
      ],
      "fastify": [
        "./dist/fastify/index.d.ts"
      ],
      "nest": [
        "./dist/nest/index.d.ts"
      ],
      "prisma": [
        "./dist/prisma/index.d.ts"
      ],
      "knex": [
        "./dist/knex/index.d.ts"
      ],
      "drizzle": [
        "./dist/drizzle/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "prisma",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "qs": "^6.15.2"
  },
  "peerDependencies": {
    "@fastify/formbody": ">=7",
    "@nestjs/common": ">=10",
    "@prisma/client": ">=5",
    "better-sqlite3": ">=11",
    "drizzle-orm": ">=0.36",
    "express": ">=4.18",
    "fastify": ">=4.27",
    "knex": "^3.1.0",
    "mysql2": ">=3",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@fastify/formbody": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@fastify/formbody": "^8.0.2",
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/testing": "^11.1.26",
    "@prisma/client": "^6.19.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "better-sqlite3": "^12.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "fastify": "^5.8.5",
    "knex": "^3.1.0",
    "mysql2": "^3.24.4",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
